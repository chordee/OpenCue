# Portainer stack 的環境變數。
# 在 Portainer 的 Stacks → Add stack → Environment variables 逐項填入，
# 或用 "Load variables from .env file" 上傳。

# --- 資料庫 ---
POSTGRES_USER=cuebot
POSTGRES_DB=cuebot
# 正式環境務必改掉。注意這個值同時被 db、flyway、cuebot 三個服務使用。
POSTGRES_PASSWORD=change_me

# --- Image ---
# 測試階段：本機 docker compose build 產生的 image（Portainer 與 docker 共用同一個
# daemon，所以本機 image 可直接引用，不需要 registry）。
# 正式環境：改成 registry 上的明確 tag，例如
#   OPENCUE_CUEBOT_IMAGE=registry.example.com/opencue/cuebot:1.34.4
OPENCUE_CUEBOT_IMAGE=opencue-cuebot:latest
OPENCUE_FLYWAY_IMAGE=opencue-flyway:latest

# --- 對外 port ---
# Windows render node 上的 RQD 要連這個 port。
CUEBOT_GRPC_PORT=8443

# --- Frame log 根目錄 ---
# 由 render node 上的 RQD 寫入，不是 Cuebot。必須是所有 render node 都寫得到的
# 同一位置。Windows 節點請填 UNC 路徑，例如 //fileserver/opencue/logs
CUE_FRAME_LOG_DIR=/tmp/rqd/logs

# --- Render node 名稱解析 ---
# Cuebot 會把 RQD 回報的主機名稱截成第一段，再用它回連該節點的 8444。
# 若公司 DNS 已能解析節點短名稱，這兩項可留空並把 compose 的 extra_hosts 拿掉。
# 本次測試：render node 是 Docker 宿主本身（Windows），所以指向 host-gateway。
# 正式環境：填該 Windows 節點的名稱與實際 IP。
RENDER_NODE_NAME=LAPTOP-ULJICLO8
RENDER_NODE_ADDR=host-gateway
