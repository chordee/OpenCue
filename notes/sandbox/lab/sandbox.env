# Local sandbox (Windows + Docker Desktop) environment variables, for reference only.
# For production deployments, use notes/deploy/server/env.example.
# Portainer stack environment variables.
# Configure under Portainer: Stacks -> Add stack -> Environment variables,
# or upload via "Load variables from .env file".
# For docker compose route, copy as .env and pass via --env-file .env (see notes/sandbox/22-two-deployment-routes.md).
#
# Mandatory: POSTGRES_PASSWORD, JWT_SECRET, CUEWEB_NEXTAUTH_SECRET, CUE_FRAME_LOG_DIR,
#            five OPENCUE_*_IMAGE variables. Deployment fails immediately if omitted.
# All other settings have defaults in opencue.portainer.yml.

# --- Database ---
POSTGRES_USER=cuebot
POSTGRES_DB=cuebot
# Must change in production. Note: shared by db, flyway, and cuebot services.
POSTGRES_PASSWORD=change_me

# --- Container Images ---
# Default targets are pre-built public images on GHCR, pullable without authentication
# and eliminating local registry requirements (generated via .github/workflows/sandbox-images.yml, see notes/sandbox/22-two-deployment-routes.md).
# All five OPENCUE_*_IMAGE variables must use the same version tag.
#
# Alternative image sources:
#   Self-hosted registry: OPENCUE_CUEBOT_IMAGE=registry.example.com/opencue/cuebot:1.34.4-xxxxxxxx
#   Local docker compose build: opencue/cuebot:local
# Production mandate: Use explicit version tags; never use latest.
# Tag convention: <version>-<short-commit-sha> to ensure source traceability.
OPENCUE_CUEBOT_IMAGE=ghcr.io/chordee/opencue/cuebot:1.34.4-1d73523b
OPENCUE_FLYWAY_IMAGE=ghcr.io/chordee/opencue/flyway:1.34.4-1d73523b

# --- External Network Ports ---
# RQD instances on Windows render nodes connect to this gRPC port.
CUEBOT_GRPC_PORT=8443

# --- Frame Log Root Directory ---
# Written directly by RQD on render nodes, not by Cuebot (Cuebot forwards string verbatim).
# Must reflect the path syntax of the render node platform, not the Linux Docker host.
# In this environment render nodes are Windows hosts; use Windows path format.
#
# [Forward-slash UNC syntax mandatory; other asset paths may use drive letters]
# In addition to RQD writing files, CueWeb reads logs from this path inside Linux containers.
# Linux containers fail to parse Windows drive letters like L:/... (path.isAbsolute returns false, triggering HTTP 400).
# Forward-slash UNC syntax resolves across both Windows and Linux hosts.
# See notes/sandbox/13-cueweb-and-rest-gateway.md and notes/sandbox/11-production-risks-and-todos.md Section 2.
#
# Scene files and render outputs may continue using drive letter conventions
# (empirically verified: RQD in user sessions accesses drive letters cleanly).
# In multi-node farms, this must point to shared UNC storage accessible by all nodes,
# e.g. //fileserver/opencue/logs
CUE_FRAME_LOG_DIR=C:/opencue/logs

# --- Render Node Hostname Resolution ---
# Cuebot truncates hostnames reported by RQD to the first token and connects back on port 8444.
# If studio DNS resolves short hostnames, leave empty and remove extra_hosts in compose.
# Test environment: render node is the Docker host machine (Windows), targeting host-gateway.
# Production environment: populate with node short hostname and IP address.
RENDER_NODE_NAME=LAPTOP-ULJICLO8
RENDER_NODE_ADDR=host-gateway

# --- CueWeb / REST Gateway ---
OPENCUE_REST_GATEWAY_IMAGE=ghcr.io/chordee/opencue/rest-gateway:1.34.4-1d73523b
OPENCUE_CUEWEB_IMAGE=ghcr.io/chordee/opencue/cueweb:1.34.4-1d73523b

# JWT secret shared between REST Gateway and CueWeb. Must change in production.
JWT_SECRET=change_me_jwt_secret

# CueWeb public port and URL
CUEWEB_PORT=3000
CUEWEB_PUBLIC_URL=http://localhost:3000
CUEWEB_NEXTAUTH_SECRET=change_me_nextauth_secret

# Frame log bind mount. CueWeb requires file access to display logs.
# Test environment: render node is local Windows, logs at C:\opencue\logs,
#                   mounted into Docker Desktop via /mnt/c/...
# Production environment: Mount shared network storage matching render nodes (UNC mount target).
# [Docker Desktop specific]: Portainer issues commands directly to Docker daemon without WSL path translation;
# use host daemon paths. Docker Desktop maps Windows drives under /run/desktop/mnt/host/<drive>/.
# Native Linux hosts omit this prefix; use actual mount points, e.g. /mnt/opencue/logs.
FRAME_LOG_MOUNT_SOURCE=/run/desktop/mnt/host/c/opencue/logs
FRAME_LOG_MOUNT_TARGET=/mnt/logs
# Log read whitelist for security hardening; restricts access to designated log mount.
CUEWEB_LOG_ROOTS=/mnt/logs

# Render image preview whitelist. Defaults to HTTP 403 (fail-closed) when omitted.
# Points to render output directory, distinct from frame log directory.
RENDER_OUT_MOUNT_SOURCE=/run/desktop/mnt/host/c/opencue/render
RENDER_OUT_MOUNT_TARGET=/mnt/render
CUEWEB_PREVIEW_ROOTS=/mnt/render

# --- Per-OS Frame Log Roots ---
# Cuebot selects log roots based on job OS (JobLogUtil.java:59), falling back to CUE_FRAME_LOG_DIR.
# Mandatory in hybrid OS farms to prevent Linux nodes receiving Windows paths and creating literal "C:" folders.
FRAME_LOG_ROOT_WINDOWS=C:/opencue/logs
FRAME_LOG_ROOT_LINUX=/tmp/rqd/logs

# --- Post-Deployment Initialization (opencue-init container) ---
# Seeds shows, subscriptions, and services idempotently.
# When OPENCUE_INIT_* variables are empty, init container performs no action.
OPENCUE_INIT_IMAGE=ghcr.io/chordee/opencue/init:1.34.4-1d73523b
# Comma-separated list of show names
OPENCUE_INIT_SHOWS=
# Allocations subscribed by new shows. [Without the allocation hosting nodes, jobs stall in WAITING]
# Windows workstations default to local.desktop, included in baseline defaults.
#OPENCUE_INIT_ALLOCS=local.general,local.desktop,cloud.general
#OPENCUE_INIT_SUB_CORES=1000
# Service definitions (single-line JSON array). Field reference: notes/sandbox/22-two-deployment-routes.md.
OPENCUE_INIT_SERVICES=[{"name":"houdini2204","tags":["houdini_22_0_429"],"min_memory_gb":4},{"name":"maya2027","tags":["maya_2027"],"min_memory_gb":8},{"name":"nuke17","tags":["nuke_17_0v1"],"min_memory_gb":4}]
