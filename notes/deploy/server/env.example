# OpenCue Server Environment Variables Template
#
# Portainer: Stacks -> Add stack -> Environment variables (enter one by one),
#            or use "Load variables from .env file" to upload this file.
# Docker Compose: Copy as .env and specify via --env-file .env.
#
# Variables labeled [Mandatory] will cause deployment errors if left blank.
# Other items have defaults defined in opencue.portainer.yml.
# Detailed technical rationale can be found in notes/deploy/01-server.md.

# =============================================================================
# Database
# =============================================================================
POSTGRES_USER=cuebot
POSTGRES_DB=cuebot
# [Mandatory] Shared across db, flyway, and cuebot services
POSTGRES_PASSWORD=

# =============================================================================
# Container Images
# =============================================================================
# Defaults point to public images on GHCR (no authentication required).
# All five services must share the identical release tag. Do not use latest.
# When using a self-hosted registry: registry.example.com/opencue/cuebot:1.34.4-xxxxxxxx
# [Mandatory]
OPENCUE_CUEBOT_IMAGE=ghcr.io/chordee/opencue/cuebot:1.37.0-752ed9cf
OPENCUE_FLYWAY_IMAGE=ghcr.io/chordee/opencue/flyway:1.37.0-752ed9cf
OPENCUE_REST_GATEWAY_IMAGE=ghcr.io/chordee/opencue/rest-gateway:1.37.0-752ed9cf
OPENCUE_CUEWEB_IMAGE=ghcr.io/chordee/opencue/cueweb:1.37.0-752ed9cf
OPENCUE_INIT_IMAGE=ghcr.io/chordee/opencue/init:1.37.0-752ed9cf

# =============================================================================
# External Ports
# =============================================================================
# Render node RQD daemons and client tools connect to this port
CUEBOT_GRPC_PORT=8443
CUEWEB_PORT=3000

# =============================================================================
# Frame Log Root Directory
# =============================================================================
# Written to by render node RQD daemons, passed downstream by Cuebot.
# Also read by CueWeb (Linux container).
# [Must use forward-slash UNC syntax]: Only format valid on both Windows and Linux containers.
# Drive letters (e.g. L:/...) return HTTP 400 in CueWeb.
# [Mandatory]
CUE_FRAME_LOG_DIR=//fileserver/opencue/logs

# Only needed for hybrid OS farms; defaults to CUE_FRAME_LOG_DIR if unset.
# OS name maps to the job os field (Windows / debian ...).
#FRAME_LOG_ROOT_WINDOWS=//fileserver/opencue/logs
#FRAME_LOG_ROOT_LINUX=/mnt/opencue/logs

# =============================================================================
# Render Node Name Resolution
# =============================================================================
# Cuebot callbacks connect to node port 8444 using the node's short hostname.
# When the host resolves short names via DNS search domains, leave both unset.
# Only populate for single-node tests without DNS. For multiple hosts, use site.example.yml.
#RENDER_NODE_NAME=RENDER01
#RENDER_NODE_ADDR=192.168.1.101

# =============================================================================
# CueWeb
# =============================================================================
# [Mandatory] Secret used by CueWeb backend to call REST Gateway (not user login)
JWT_SECRET=
# [Mandatory] NextAuth secret
CUEWEB_NEXTAUTH_SECRET=
# URL accessed by users in their browsers
CUEWEB_PUBLIC_URL=http://opencue-server.studio.local:3000

# Frame log storage mount point on the Linux Docker host.
# Host must have share mounted (handled by IT). If unset, CueWeb starts without log viewing.
FRAME_LOG_MOUNT_SOURCE=/mnt/opencue/logs
# [Must equal CUE_FRAME_LOG_DIR with one leading slash removed]
# Cuebot delivers log paths starting with //fileserver/... which maps to /fileserver/... in Linux.
FRAME_LOG_MOUNT_TARGET=/fileserver/opencue/logs
# Whitelist for log viewing (identical to above)
CUEWEB_LOG_ROOTS=/fileserver/opencue/logs

# Render output mount point for web thumbnail previews. Optional.
# Browsers cannot display raw EXR files; PNG/JPG proxies must be generated.
#RENDER_OUT_MOUNT_SOURCE=/mnt/projects/render
#RENDER_OUT_MOUNT_TARGET=/mnt/render
#CUEWEB_PREVIEW_ROOTS=/mnt/render

# =============================================================================
# Monitoring (Only needed with monitoring.portainer.yml)
# =============================================================================
# Set true to enable queue health metrics. Basic metrics do not require this.
#CUEBOT_METRICS_COLLECTOR=true

# =============================================================================
# Post-deployment Initialization (opencue-init container)
# =============================================================================
# Bootstraps shows, subscriptions, and services. Idempotent; existing items unchanged.
# If both are left empty, the init container takes no action.

# Comma-separated show names
OPENCUE_INIT_SHOWS=

# Allocations subscribed to by new shows. [Missing node allocation stalls jobs in WAITING]
#OPENCUE_INIT_ALLOCS=local.general,local.desktop,cloud.general
#OPENCUE_INIT_SUB_CORES=1000

# Service definitions (JSON array on a single line). Tags match RQD_TAGS in rqd.conf.
# Example:
#OPENCUE_INIT_SERVICES=[{"name":"houdini2204","tags":["houdini_22_0_429"],"min_memory_gb":4},{"name":"maya2027","tags":["maya_2027"],"min_memory_gb":8},{"name":"nuke17","tags":["nuke_17_0v1"],"min_memory_gb":4}]
OPENCUE_INIT_SERVICES=
