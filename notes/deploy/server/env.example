# OpenCue 伺服器的環境變數範本
#
# Portainer：Stacks → Add stack → Environment variables 逐項填入，
#            或用「Load variables from .env file」上傳本檔
# docker compose：複製成 .env，以 --env-file .env 指定
#
# 標【必填】的沒填，部署時會直接報錯。其他項目都有預設值（寫在 opencue.portainer.yml）。
# 每一項的背景說明見 notes/deploy/01-伺服器.md。

# =============================================================================
# 資料庫
# =============================================================================
POSTGRES_USER=cuebot
POSTGRES_DB=cuebot
# 【必填】db、flyway、cuebot 三個服務共用這個值
POSTGRES_PASSWORD=

# =============================================================================
# Image
# =============================================================================
# 預設是公開在 GHCR 的現成 image，不需登入即可 pull，也不需要自建 registry。
# 五個要用同一個 tag。使用明確版本 tag，不要用 latest。
# 改用自建 registry 時，例如 registry.example.com/opencue/cuebot:1.34.4-xxxxxxxx
# 【必填】
OPENCUE_CUEBOT_IMAGE=ghcr.io/chordee/opencue/cuebot:1.34.4-1d73523b
OPENCUE_FLYWAY_IMAGE=ghcr.io/chordee/opencue/flyway:1.34.4-1d73523b
OPENCUE_REST_GATEWAY_IMAGE=ghcr.io/chordee/opencue/rest-gateway:1.34.4-1d73523b
OPENCUE_CUEWEB_IMAGE=ghcr.io/chordee/opencue/cueweb:1.34.4-1d73523b
OPENCUE_INIT_IMAGE=ghcr.io/chordee/opencue/init:1.34.4-1d73523b

# =============================================================================
# 對外 port
# =============================================================================
# 算圖節點的 RQD 與 artist 的用戶端工具連這個 port
CUEBOT_GRPC_PORT=8443
CUEWEB_PORT=3000

# =============================================================================
# Frame log 根目錄
# =============================================================================
# 由算圖節點上的 RQD 寫入，Cuebot 只把這個字串傳下去。
# 同時 CueWeb（Linux 容器）也會拿它去讀檔。
# 【必須用 UNC 正斜線】這是 Windows 節點與 Linux 容器兩邊都成立的唯一寫法。
# 磁碟機代號（L:/...）在 CueWeb 會直接回 400。
# 【必填】
CUE_FRAME_LOG_DIR=//fileserver/opencue/logs

# 混合作業系統的農場才需要分開設定，沒填就沿用 CUE_FRAME_LOG_DIR。
# 名稱中的 OS 對應 job 的 os 欄位（Windows / debian ...）。
#FRAME_LOG_ROOT_WINDOWS=//fileserver/opencue/logs
#FRAME_LOG_ROOT_LINUX=/mnt/opencue/logs

# =============================================================================
# 算圖節點名稱解析
# =============================================================================
# Cuebot 會用節點的短名稱回連節點的 8444，那個名稱要在 Cuebot 容器內解析得到。
# 宿主本身能用 DNS 解析節點短名稱時，兩項都留空即可（容器會沿用宿主的設定）。
# 只有單台測試、又沒有 DNS 時才填。多台請改用 site.example.yml。
#RENDER_NODE_NAME=RENDER01
#RENDER_NODE_ADDR=192.168.1.101

# =============================================================================
# CueWeb
# =============================================================================
# 【必填】CueWeb 伺服器端呼叫 REST Gateway 用的密鑰，與使用者登入無關
JWT_SECRET=
# 【必填】
CUEWEB_NEXTAUTH_SECRET=
# 使用者在瀏覽器輸入的網址
CUEWEB_PUBLIC_URL=http://opencue-server.studio.local:3000

# frame log 共享在「Linux 宿主上」的掛載點。CueWeb 要讀得到才能顯示 log。
# 宿主要先掛好共享（IT 處理）。沒填時 CueWeb 照常啟動，只是看不到 log。
FRAME_LOG_MOUNT_SOURCE=/mnt/opencue/logs
FRAME_LOG_MOUNT_TARGET=/mnt/logs
# 讀取 log 的白名單，限縮在上面的掛載點
CUEWEB_LOG_ROOTS=/mnt/logs

# 算圖輸出的掛載點，供網頁縮圖預覽。不需要預覽可以不填。
# 瀏覽器無法直接顯示 EXR，需另外產生 PNG / JPG 代理圖。
#RENDER_OUT_MOUNT_SOURCE=/mnt/projects/render
#RENDER_OUT_MOUNT_TARGET=/mnt/render
#CUEWEB_PREVIEW_ROOTS=/mnt/render

# =============================================================================
# 部署後初始化（opencue-init 容器）
# =============================================================================
# 建立 show、subscription、service。可重複執行，已存在的不會修改。
# 兩項都留空時 init 容器什麼都不做。

# 逗號分隔的 show 名稱
OPENCUE_INIT_SHOWS=

# 新 show 要訂閱的 allocation。【少了節點所在的 allocation，job 會永遠 WAITING】
#OPENCUE_INIT_ALLOCS=local.general,local.desktop,cloud.general
#OPENCUE_INIT_SUB_CORES=1000

# service 定義（JSON 陣列，要寫在同一行）。tags 對應節點 rqd.conf 的 RQD_TAGS。
# 範例：
#OPENCUE_INIT_SERVICES=[{"name":"houdini2204","tags":["houdini_22_0_429"],"min_memory_gb":4},{"name":"maya2027","tags":["maya_2027"],"min_memory_gb":8},{"name":"nuke17","tags":["nuke_17_0v1"],"min_memory_gb":4}]
OPENCUE_INIT_SERVICES=
